	<string name="setup_grant_title">Passaggio 3: concedi l’autorizzazione dal secondo dispositivo</string>
	<string name="setup_grant_body">Apri questo link sul secondo dispositivo e segui le istruzioni:</string>
	<string name="setup_alternatives">In alternativa, puoi eseguire un comando ADB o usare l’accesso root per concedere l’autorizzazione. È supportato anche Shizuku.</string>
	<string name="setup_permission_granted">Autorizzazione concessa.</string>
	<string name="setup_permission_not_granted">Autorizzazione non ancora concessa. Completa la configurazione con il secondo dispositivo.</string>
	<string name="setup_usb_debugging_disabled">Attiva Debug USB</string>
	<string name="setup_usb_debugging_enabled">Debug USB attivo</string>
	<string name="setup_usb_debugging_enable_toast">Attiva Debug USB in Opzioni sviluppatore.</string>
