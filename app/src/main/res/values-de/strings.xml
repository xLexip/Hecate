	<string name="setup_developer_mode_body">Aktiviere USB-Debugging in den Entwickleroptionen.</string>
	<string name="setup_developer_options_unlock">Entwickleroptionen freischalten</string>
	<string name="setup_developer_options_enabled">Entwickleroptionen aktiviert</string>
	<string name="setup_dev_options_toast_one">Finde die Build-Nummer und tippe 7-mal darauf, um die Entwickleroptionen zu aktivieren.</string>
	<string name="setup_dev_options_toast_two">Nutze die Suchfunktion, wenn du sie nicht findest.</string>
	<string name="setup_alternative_methods">Alternative Methoden</string>
	<string name="setup_grant_title">Schritt 3: Berechtigung vom zweiten Gerät erteilen</string>
	<string name="setup_grant_body">Öffne diesen Link auf dem zweiten Gerät und folge den Anweisungen:</string>
	<string name="setup_alternatives">Alternativ kannst du selbst einen ADB-Befehl ausführen oder die Berechtigung mit Root erteilen. Shizuku wird ebenfalls unterstützt.</string>
	<string name="setup_permission_granted">Berechtigung erteilt.</string>
	<string name="setup_permission_not_granted">Berechtigung noch nicht erteilt. Schließe die Einrichtung mit dem zweiten Gerät ab.</string>
	<string name="setup_usb_debugging_disabled">USB-Debugging aktivieren</string>
	<string name="setup_usb_debugging_enabled">USB-Debugging aktiviert</string>
